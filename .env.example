# --- Tavus -------------------------------------------------------------
# API key from https://maker.tavus.io/dev/api-keys
TAVUS_API_KEY=
# Written by `npm run agent:sync` into agent/.tavus-ids.json; set it here in production.
# TAVUS_PAL_ID=

# --- App ---------------------------------------------------------------
# Signs login cookies. Any random string of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Public HTTPS origin Tavus calls back into for server tools (booking, preferences).
# Locally, leave empty: lookups still work; booking needs a deployed URL.
APP_BASE_URL=
# Shared secret Tavus uses to HMAC-sign server tool calls (X-Tavus-Signature). 24+ random characters.
TAVUS_TOOL_SECRET=
# Comma-separated emails of licensed advisors; their accounts can open /app/advisor.
ADVISOR_EMAILS=
# Comma-separated emails of admins; their accounts see every call's agent trace and run evals at /app/admin.
ADMIN_EMAILS=
# Optional: require this code at sign-up, so strangers can't spend your Tavus minutes.
INVITE_CODE=
# Call caps: per account per hour, and across everyone per day. Call length in seconds.
CALLS_PER_ACCOUNT_PER_HOUR=4
CALLS_PER_DAY=30
MAX_CALL_SECONDS=270

# --- Database ----------------------------------------------------------
# Postgres connection string (Neon via Vercel Storage). Empty = embedded PGlite in .data/ (local dev, tests).
DATABASE_URL=
